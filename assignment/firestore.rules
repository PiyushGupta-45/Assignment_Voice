rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /lyrics/{lyricId} {
      // Every device signs in anonymously. A user can create only their own
      // lyric and cannot browse, modify, or delete anyone else's records.
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.language is string
                    && request.resource.data.lines is list;
      allow read, update, delete: if request.auth != null
                                  && resource.data.ownerId == request.auth.uid;
    }
  }
}
